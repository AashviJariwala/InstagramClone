@model Instagram.Models.ResponseData
@{
    ViewBag.Title = "Account Privacy";
}

            <form method="post" >

<div class="container mt-4" style="max-width: 600px;">

    <h3 class="fw-bold mb-4">Account privacy</h3>

    <div class="privacy-box p-3 border rounded-4 d-flex justify-content-between align-items-center">
        <span class="fw-semibold fs-5">
            Private account
        </span>

        <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input fs-4" id="switchPrivate"
                       name="IsPrivate"
                @(Model.data.is_private=="1" ? "checked" : "") />
        </div>
    </div>

    <p class="mt-3 text-secondary" style="font-size: 14px;">
        When your account is public, your profile and posts can be seen by anyone,
        on or off Instagram, even if they don't have an Instagram account.
    </p>

    <p class="text-secondary" style="font-size: 14px;">
        When your account is private, only the followers you approve can see what you share,
        including your photos or videos on hashtag and location pages, and your followers and
        following lists. Certain info on your profile, like your profile picture and username, is
        visible to everyone on and off Instagram.
        <a href="#" class="text-primary">Learn more</a>
    </p>

    <div class="mt-4">
            <div class="mt-4">
                <button class="btn btn-primary px-4" id="btnSave">Save</button>
            </div>
    </div>
</div>
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script>
    $("#btnSave").click(function (e) {
        e.preventDefault(); // 👈 stop form submission

        const isPrivate = $("#switchPrivate").prop("checked");
        console.log(isPrivate);

        $.ajax({
            url: "/Profile/UpdatePrivacyStatus",
            type: "POST",
            data: { IsPrivate: isPrivate },
            success: function (response) {
            },
            error: function (xhr) {
                console.log(xhr);
            }
        });
    });
</script>

