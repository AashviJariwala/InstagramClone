@model Instagram.Models.Request

<!DOCTYPE html>
<html>
<head>
    <title>Requests</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
        background-color: white;
        font-family: Arial, sans-serif;
        }

        .suggestion-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-bottom: 1px solid #eee;
        }

        .left-section {
        display: flex;
        align-items: center;
        }

        .text-info {
        margin-left: 12px;
        }

        .username {
        font-weight: 600;
        font-size: 14px;
        color:black;
        }

        .fullname {
        font-size: 13px;
        color: black;
        }

        .profile-pic {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        }

        .notif-actions button {
        margin-left: 5px;
        padding: 6px 16px;
        }

        .follow-btn {
        margin-left: auto;
        background-color: #3867d6;
        color: #fff;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 14px;
        }

        .following-btn {
            margin-left: auto;
            background-color: #e4e6eb; /* light gray background */
            color: #000; /* black text */
            border: none;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
        }

            .following-btn:hover {
                background-color: #d8dadf; /* darker gray on hover */
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h3>Notifications</h3>
        <div class="list-group mt-3">
            @foreach (var item in Model.data)
            {
                <div class="suggestion-card">

                    <!-- LEFT SIDE -->
                    <div class="left-section">
                        <img src="@(string.IsNullOrEmpty(item.profile) ? Url.Content("~/images/defaultProfilePic.jpg") : item.profile)"
                        class="profile-pic" />

                        <div class="text-info">
                            <div class="username">@item.username</div>
                            <div class="fullname">@item.fullName</div>
                        </div>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="notif-actions">
                            <a href="@Url.Action("AcceptRequest","Request", new { id = item.id })" style="text-decoration:none" class="btn btn-primary btn-sm">
                                Confirm
                            </a>
                            <a href="@Url.Action("RejectRequest","Request", new { id = item.id })" style="text-decoration:none" class="btn btn-light btn-sm">
                                Delete
                            </a>
                    </div>

                </div>
            }
        </div>
    </div>
</body>
</html>