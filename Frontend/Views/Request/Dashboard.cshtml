@model Instagram.Models.Request

<!DOCTYPE html>
<html>
<head>
    <title>Requests</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: white;
            font-family: Arial, sans-serif;
        }

        .suggestion-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

        .search-item {
            display: flex;
            align-items: center;
            padding: 10px 0;
        }

        .left-section {
            display: flex;
            align-items: center;
        }

        .text-info {
            margin-left: 12px;
        }

        .username {
            font-weight: 600;
            font-size: 14px;
            color: black;
        }

        .fullname {
            font-size: 13px;
            color: black;
        }

        .profile-pic {
            width: 45px;
            height: 45px;
            border-radius: 50%;
        }

        .notif-actions button {
            margin-left: 5px;
            padding: 6px 16px;
        }

        .follow-btn {
            margin-left: auto;
            background-color: #3867d6;
            color: #fff;
            border: none;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 14px;
        }

        .following-btn {
            margin-left: auto;
            background-color: #e4e6eb; /* light gray background */
            color: #000; /* black text */
            border: none;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
        }

            .following-btn:hover {
                color: black; /* darker gray on hover */
            }

            .follow-btn:hover {
                color: white; /* darker gray on hover */
            }

        .glass-card {
            display: inline-flex;
            align-items: center;
            gap: 15px;
            padding: 18px 25px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-decoration: none;
            color: black;
            transition: 0.3s ease;
        }

            .glass-card img {
                height: 40px;
                width: 40px;
            }

            .glass-card span {
                font-size: 17px;
                font-weight: 600;
            }

            .glass-card:hover {
                transform: scale(1.05);
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h3>Notifications</h3>
        <div class="list-group mt-3">
            <a asp-action="PendingRequestList" class="glass-card">
                <img src="~/images/pendingreq.png" />
                <span>Pending Requests</span>
            </a>
            @foreach (var item in Model.data)
            {
                <div class="suggestion-card">

                    <!-- LEFT SIDE -->
                    <div class="left-section">
                        <a href="@Url.Action("UserProfile","Search", new { id = item.id })" style="text-decoration:none;color:black">
                            <div class="search-item">
                                <img src="@(string.IsNullOrEmpty(item.profile) ? Url.Content("~/images/defaultProfilePic.jpg") : item.profile)" class="profile-pic" />&nbsp;&nbsp;&nbsp;
                                <div class="info">
                                    <div class="username">@item.username</div>
                                    <div class="subtitle">@(string.IsNullOrEmpty(item.fullName) ? "" : item.fullName) </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="notif-actions">
                        @if (item.status=="requested")
                        {
                            <a href="#" class="following-btn" style="text-decoration:none">Requested</a>
                        }
                        else if(item.status=="following")
                        {
                            <a href="#" class="following-btn" style="text-decoration:none">Following</a>
                        }
                        else
                        {
                            <a href="@Url.Action("SendRequest","Request", new { id = item.id })" style="text-decoration:none" class="follow-btn">Follow back</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>