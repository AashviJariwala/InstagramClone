<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PixieGram</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Instagram.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header>
    </header>

    <div class="wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <!-- Top Icons -->
            <div class="sidebar-top">
                <!-- Instagram Logo -->
                <img src="~/images/logo.jpg" alt="logo" width="40" height="40" class="mb-3"  />

                <!-- Menu -->
                <a href="@Url.Action("Dashboard","Post")" style="text-decoration:none;color:black;margin-top:20px;">
                    <i class="bi bi-house-door fs-4 mb-3" title="Home"></i>
                </a>
                <a href="@Url.Action("searchProfiles","Search")" style="text-decoration:none;color:black">
                    <i class="bi bi-search fs-4 mb-3" title="Search"></i>
                </a>
                <a href="@Url.Action("Reels","Reel")" style="text-decoration:none;color:black">
                    <img src="~/images/reel.png" alt="Reels" width="27" height="27" class="mb-3" title="Reels" />
                </a>
                <a href="@Url.Action("LoadSpin","Spin")" style="text-decoration:none;color:black">
                    <img src="~/images/spin.png" alt="Spin" width="31" height="31" class="mb-3" />
                </a>
                <a href="@Url.Action("Dashboard","Request")" style="text-decoration:none;color:black">
                    <img src="~/images/likes_blank.jpg" alt="Like" width="36" height="31" class="mb-3" />
                </a>
                <a href="@Url.Action("Create","UploadMedia")" style="text-decoration:none;color:black">
                    <i class="bi bi-plus-square fs-4 mb-3" title="Create"></i>
                </a>
                <a href="@Url.Action("Profile","Profile",new { id = 0 })" style="text-decoration:none;color:black">
                    <i class="bi bi-person fs-4 mb-3" title="Profile"></i>
               </a>
            </div>

            <!-- Bottom Icon -->
            <div class="sidebar-bottom" id="moreBtn">
                <i class="bi bi-list fs-4" title="More"></i>
            </div>

            <!-- Modal Overlay -->
            <div class="more-modal-overlay" id="moreModal">
                <div class="more-menu">
                    <ul>
                        <li><i class="bi bi-lock"></i>
                            <a href="@Url.Action("ShowPrivacyStatus","Profile")" style="text-decoration:none;color:black"> Account Privacy
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0)" onclick="openLogoutDialog()" style="text-decoration:none;color:black">
                                <i class="bi bi-box-arrow-right"></i> Log out
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </aside>


        <!-- Feed -->
        <main class="feed">
            @RenderBody()
        </main>
    </div>
    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px;">
                <div class="modal-body text-center p-4">
                    <h4 class="mb-2">Logging Out</h4>
                    <p class="text-muted mb-4">You need to log back in.</p>

                    <div class="d-flex justify-content-evenly">
                        <div>
                            <a href="@Url.Action("Logout","Profile")" style="text-decoration:none;color:white" class="btn btn-secondary px-4">
                                Logout
                            </a>
                        </div>
                        <div>
                            <button class="btn btn-secondary px-4" data-bs-dismiss="modal">
                                Cancel
                            </button>
                        </div>

                       
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const moreBtn = document.getElementById("moreBtn");
        const moreModal = document.getElementById("moreModal");

        // Open
        moreBtn.addEventListener("click", () => {
            moreModal.style.display = "block";
        });

        // Close when clicking outside
        moreModal.addEventListener("click", (e) => {
            if (e.target === moreModal) {
                moreModal.style.display = "none";
            }
        });




    </script>

    <script>
        function openLogoutDialog() {
            var modal = new bootstrap.Modal(document.getElementById('logoutModal'));
            modal.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
