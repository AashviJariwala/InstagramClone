@model Instagram.Models.ResponseData


@{
    ViewData["Title"] = "Crop";
    var imagePath = ViewBag.ImagePath;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Cropper.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f4f4f4;
            font-family: 'Segoe UI', sans-serif;
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .crop-box {
            background: #fff;
            width: 500px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            text-align: center;
            position: relative;
            padding: 30px 20px 50px;
            animation: fadeIn 0.5s ease;
        }

        .top-bar {
            position: absolute;
            top: 10px;
            left: 15px;
            right: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }


        .three-dots {
            font-size: 22px;
            cursor: pointer;
            user-select: none;
        }

        .dropdown {
            display: none;
            position: absolute;
            top: 30px;
            right: 0;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            width: 140px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
            text-align: left;
            z-index: 10;
        }

            .dropdown a {
                display: block;
                padding: 10px 15px;
                text-decoration: none;
                color: #333;
                font-size: 14px;
            }

                .dropdown a:hover {
                    background-color: #f0f0f0;
                }

        .crop-container {
            margin-top: 40px;
        }

            .crop-container img {
                max-width: 100%;
                border-radius: 10px;
            }

        .btn-crop {
            margin-top: 25px;
            background-color: #0095f6;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .btn-crop:hover {
                background-color: #0078cc;
            }

        .back-btn {
            font-size: 20px;
            font-weight: bold;
            color: #333;
            text-decoration: none;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 8px;
            transition: background-color 0.2s ease;
        }

            .back-btn:hover {
                background-color: #f0f0f0;
            }


        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }
    </style>
</head>
<body>
    <form method="post" asp-action="Crop" enctype="multipart/form-data">
        <div class="overlay">
            <div class="crop-box">
                <div class="top-bar">
                    <a asp-controller="UploadMedia" asp-action="Create" class="back-btn">←</a>
                </div>

                <h3 style="margin-top: 10px;">Crop your image</h3>

                <input type="hidden" id="CroppedImage" name="CroppedImage" />

                <div class="crop-container">
                    <img id="image" src="@imagePath" alt="Crop Image" />
                </div>

                <button type="submit" id="cropBtn" class="btn-crop">Crop & Upload</button>
            </div>
        </div>
    </form>


    <script>
        let cropper;
        window.onload = function() {
            cropper = new Cropper(document.getElementById('image'), { aspectRatio: 1 });
        };

        document.getElementById('cropBtn').addEventListener('click', function(e) {
            e.preventDefault(); // prevent form auto submit first
            const canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
            const croppedData = canvas.toDataURL("image/png");
            document.getElementById('CroppedImage').value = croppedData;
            e.target.closest('form').submit(); // now submit form
        });
    </script>
</body>
</html>

